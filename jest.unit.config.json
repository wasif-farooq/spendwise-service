{
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
        "^@shared/(.*)$": "<rootDir>/src/@shared/$1",
        "^@domains/(.*)$": "<rootDir>/src/domains/$1",
        "^@facades/(.*)$": "<rootDir>/src/facades/$1",
        "^@interfaces/(.*)$": "<rootDir>/src/interfaces/$1",
        "^@abstract-factories/(.*)$": "<rootDir>/src/abstract-factories/$1",
        "^@factories/(.*)$": "<rootDir>/src/factories/$1",
        "^@config/(.*)$": "<rootDir>/src/config/$1",
        "^@di/(.*)$": "<rootDir>/src/di/$1",
        "^@cache/(.*)$": "<rootDir>/src/cache/$1",
        "^@messaging/(.*)$": "<rootDir>/src/messaging/$1",
        "^@monitoring/(.*)$": "<rootDir>/src/monitoring/$1",
        "^@bootstrap/(.*)$": "<rootDir>/src/bootstrap/$1",
        "^@server/(.*)$": "<rootDir>/src/server/$1",
        "^@database/(.*)$": "<rootDir>/src/database/$1",
        "^@processes/(.*)$": "<rootDir>/processes/$1",
        "^@tests/(.*)$": "<rootDir>/tests/$1"
    },
    "testMatch": [
        "**/tests/unit/**/*.test.ts"
    ],
    "transform": {
        "^.+\\.ts$": ["ts-jest", {
            "useESM": false,
            "isolatedModules": true
        }]
    },
    "moduleFileExtensions": [
        "ts",
        "js",
        "json",
        "node"
    ],
    "testTimeout": 10000,
    "verbose": true
}
