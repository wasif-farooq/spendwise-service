# Server
NODE_ENV=development
PORT=3000
# Number of reverse proxies in front of the app. Rate limiting keys on the
# client IP, so this MUST be set (usually 1) when running behind an ingress or
# load balancer, or all clients share a single rate-limit bucket.
TRUST_PROXY=0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=antigravity
DB_USER=antigravity
DB_PASSWORD=password
# Optional: connection string (alternative to individual DB_* vars)
# DATABASE_URL=postgresql://antigravity:password@localhost:5432/antigravity

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092

# Messaging (queue provider)
# Options: kafka, bullmq
MESSAGE_QUEUE_PROVIDER=kafka

# JWT
# In production this must be at least 32 characters and must not be the
# placeholder below — config/environments/production.ts refuses to boot otherwise.
JWT_SECRET=development-secret-change-in-production

# CORS — comma-separated browser origins allowed to call the API.
# Required in production; development uses a built-in localhost list.
# CORS_ORIGINS=https://app.trackmypocket.com,https://trackmypocket.com

# Stripe
STRIPE_SECRET_KEY=
# REQUIRED for the webhook endpoint. Without it the handler refuses every
# event rather than trusting an unsigned body. Get it from the Stripe
# dashboard, or from `stripe listen` when testing locally.
STRIPE_WEBHOOK_SECRET=

# Exchange Rates
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_URL=https://api.exchangerate-api.com/v4/latest

# Storage (MinIO/S3)
# ENDPOINT, PUBLIC_URL and both credentials are required in production —
# they have no defaults there, so object storage cannot be left on minioadmin.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET_RECEIPTS=trackmypocket-receipts
STORAGE_BUCKET_AVATARS=trackmypocket-avatars
STORAGE_BUCKET_ATTACHMENTS=trackmypocket-attachments
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_PRESIGNED_URL_EXPIRY=3600
STORAGE_MAX_FILE_SIZE=10485760

# Monitoring
GRAFANA_PASSWORD=admin
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Activity Log
ACTIVITY_LOG_ENABLED=true
ACTIVITY_LOG_CAPTURE_IP=true
ACTIVITY_LOG_CAPTURE_USER_AGENT=true
ACTIVITY_LOG_PARTITION_MONTHS_AHEAD=6
ACTIVITY_LOG_BATCH_SIZE=50
ACTIVITY_LOG_BATCH_TIMEOUT_MS=2000

# Cron Jobs
CRON_EXCHANGE_RATES_ENABLED=true
CRON_EXCHANGE_RATES_SCHEDULE=0 2 * * *
CRON_ACTIVITY_PARTITIONS_ENABLED=true
CRON_ACTIVITY_PARTITIONS_SCHEDULE=0 0 1 * *
